# Server & Environment
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Authentication & Security
JWT_SECRET="replace_with_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Database Configuration
# Set DB_CLIENT=mysql when connecting to a MySQL 8+ server.
# Defaults to embedded persistent SQLite (./data/bizflow.sqlite) when MySQL is not configured.
DB_CLIENT="sqlite"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="bizflow_user"
MYSQL_PASSWORD="MY_MYSQL_PASSWORD"
MYSQL_DATABASE="bizflow_africa"

# Gemini AI Assistant (Server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Email (Nodemailer SMTP - optional in development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@bizflow.africa"

# Optional Super Admin Bootstrap Credentials
SUPER_ADMIN_NAME=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PHONE=""
SUPER_ADMIN_PASSWORD=""

