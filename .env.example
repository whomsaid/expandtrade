# Server & Environment
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGINS=""

# Authentication & Security
JWT_SECRET="replace_with_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Database Configuration
# Set DB_CLIENT=mysql when connecting to a MySQL 8+ server.
# Defaults to embedded persistent SQLite (./data/bizflow.sqlite) when MySQL is not configured.
DB_CLIENT="sqlite"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="biztrade_user"
MYSQL_PASSWORD="MY_MYSQL_PASSWORD"
MYSQL_DATABASE="biztrade_africa"

# Gemini AI Assistant (Server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Security Secret for OTP Hashing (set random 32+ char string in production)
OTP_SECRET="replace_with_a_long_random_otp_secret_in_production"

# Real Email Server (SMTP — Email-Only OTP & System Notifications via Brevo, SendGrid, Amazon SES, or Gmail SMTP)
# Example hosts: smtp-relay.brevo.com (587) | smtp.sendgrid.net (587) | email-smtp.eu-west-1.amazonaws.com (587) | smtp.gmail.com (587)
SMTP_PROVIDER="brevo"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BizTrade Africa <noreply@biztrade.africa>"

# Optional Super Admin Bootstrap Credentials
SUPER_ADMIN_NAME=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PHONE=""
SUPER_ADMIN_PASSWORD=""

# Mobile Money Rwanda Server-Side Integration (Never expose to client)
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_ENV="sandbox"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_CALLBACK_URL=""
MTN_MOMO_WEBHOOK_SECRET=""

AIRTEL_MONEY_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_MONEY_ENV="staging"
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
AIRTEL_MONEY_COUNTRY="RW"
AIRTEL_MONEY_CURRENCY="RWF"
AIRTEL_MONEY_CALLBACK_URL=""
AIRTEL_MONEY_WEBHOOK_SECRET=""
